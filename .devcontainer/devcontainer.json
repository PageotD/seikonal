{
    "name": "seikonal-dev",
    "image": "mcr.microsoft.com/devcontainers/rust:1-1-bookworm",
    "features": {
        "ghcr.io/devcontainers/features/python:1": {
            "version": "3.11"
        }
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "rust-lang.rust-analyzer",
                "tamasfe.even-better-toml",
                "ms-python.python",
                "task.vscode-task"
            ],
            "settings": {
                "rust-analyzer.check.command": "clippy"
            }
        }
    },
    "postCreateCommand": "cargo install cargo-deny cargo-audit && sh -c \"$(curl --location https://taskfile.dev/install.sh)\" -- -d -b /usr/local/bin"
}